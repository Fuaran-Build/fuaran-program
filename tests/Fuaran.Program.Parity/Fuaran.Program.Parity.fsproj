<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- The comparison + the seeds are Fable-clean and travel to the Fable leg as
       source; only FixtureIo is .NET-only, and the Fable leg has its own loader
       over node's fs reading the SAME files. -->
  <ItemGroup>
    <Compile Include="Parity.fs" />
    <Compile Include="Seeds.fs" />
    <Compile Include="FixtureIo.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Program.Runtime\Fuaran.Program.Runtime.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fuaran.UI" />
    <PackageReference Include="Fuaran.UI.Ops" />
    <PackageReference Include="Fuaran.UI.OpStream.Abstractions" />
    <PackageReference Include="Fuaran.UI.OpStream.Replay" />
    <PackageReference Include="Fuaran.UI.Renderer.Core" />
    <PackageReference Include="Fuaran.UI.ServerDriven" />
  </ItemGroup>
</Project>
