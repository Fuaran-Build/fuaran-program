<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SmokeTests.fs" />
    <!-- Phase 1896: the generic core at a NON-UI witness, and the boundary test
         that keeps the core UI-free. This project references the three core
         packages and no UI-tier package, so nothing UI-typed is in its graph. -->
    <Compile Include="ToyDomain.fs" />
    <Compile Include="GenericityTests.fs" />
    <!-- fuaran#2011: the toy witness as a specification subject. Its codec, the
         driver-semantics-toy family's shared runner (Fable-clean; the Fable
         parity leg and the proof host link these as source), the server-logic
         placement, the seeds, the .NET corpus IO, and the conformance leg. -->
    <Compile Include="ToyWire.fs" />
    <Compile Include="ToyScenarios.fs" />
    <Compile Include="ToyServerPlacement.fs" />
    <Compile Include="ToySeeds.fs" />
    <Compile Include="ToyCorpus.fs" />
    <Compile Include="ToyFamilyTests.fs" />
    <!-- Phase 1967: the SECOND witness — a verb over a file map, with an
         adversary per finding of the first second-domain instantiation. -->
    <Compile Include="VerbDomain.fs" />
    <Compile Include="VerbWitnessTests.fs" />
    <!-- Phase 1974: the THIRD witness — a document pipeline whose state is its
         tree, at a composition filling the state and walk axes. -->
    <Compile Include="DocDomain.fs" />
    <Compile Include="DocWitnessTests.fs" />
    <Compile Include="FlowTests.fs" />
    <Compile Include="FlowDecisionTests.fs" />
    <!-- Phase 1990: Each over a literal collection, on both axes. -->
    <Compile Include="EachTests.fs" />
    <Compile Include="HandlerDocumentTests.fs" />
    <Compile Include="AtMostTests.fs" />
    <Compile Include="CoreBoundaryTests.fs" />
    <Compile Include="SchemaClockTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Program\Fuaran.Program.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Program.Bounded\Fuaran.Program.Bounded.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Program.Runtime\Fuaran.Program.Runtime.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Program.Server\Fuaran.Program.Server.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
  </ItemGroup>
</Project>
