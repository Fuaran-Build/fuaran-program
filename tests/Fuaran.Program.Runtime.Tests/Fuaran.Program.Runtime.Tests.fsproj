<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ProgramTests.fs" />
    <Compile Include="DemandedStrictTests.fs" />
    <!-- Program.fs is the Expecto entry point and stays last. -->
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Program.Runtime\Fuaran.Program.Runtime.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fuaran.UI" />
    <PackageReference Include="Fuaran.UI.Ops" />
    <PackageReference Include="Fuaran.UI.OpStream.Replay" />
    <PackageReference Include="Fuaran.UI.Renderer.Core" />
    <PackageReference Include="Fuaran.UI.ServerDriven" />
  </ItemGroup>
</Project>
