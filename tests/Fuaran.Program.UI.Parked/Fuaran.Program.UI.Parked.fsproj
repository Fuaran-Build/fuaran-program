<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!-- PARKED, NOT PACKED (Phase 1896). The UI tier's instantiation of the
       domain-generic core: the UI witness (view, leaf lowering, codecs, store,
       claim verifier), the pre-generic names as aliases over it, and the UI
       transport loop (the bounded driver, its channel glue, and the client
       runtime). The core packages reference no UI-tier package, so this is
       what the existing suite, the scenario corpus and the sample run through.

       Fable-clean, and split from its .NET-only sibling
       (Fuaran.Program.Server.UI.Parked) along the same line as the core. Laid
       out file for file as the `Fuaran.Program.UI` adapter package Phase 1897
       ships: that phase promotes these files by moving them, and flips
       IsPackable there. Namespace `Fuaran.Program.UI` already. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ClientEffects.fs" />
    <Compile Include="UiWitness.fs" />
    <Compile Include="Aliases.fs" />
    <Compile Include="BoundedDriver.fs" />
    <Compile Include="BoundedConnection.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Program.Runtime\Fuaran.Program.Runtime.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fuaran.UI" />
    <PackageReference Include="Fuaran.UI.Ops.Abstractions" />
    <PackageReference Include="Fuaran.UI.Ops" />
    <PackageReference Include="Fuaran.UI.Renderer.Core" />
    <PackageReference Include="Fuaran.UI.OpStream.Abstractions" />
    <PackageReference Include="Fuaran.UI.OpStream.Replay" />
    <PackageReference Include="Fuaran.UI.ServerDriven" />
  </ItemGroup>

</Project>
