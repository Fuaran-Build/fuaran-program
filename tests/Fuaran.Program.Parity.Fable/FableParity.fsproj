<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DefineConstants>FABLE_COMPILER</DefineConstants>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- fuaran#2011: the toy witness, its codec and the driver-semantics-toy
         family's shared runner, compiled to JavaScript. Since fuaran#2012 this
         leg runs the toy family alone: the UI-vocabulary family's Fable leg left
         with the UI adapters, so nothing here reaches a UI-tier type. -->
    <Compile Include="..\Fuaran.Program.Tests\ToyDomain.fs" Link="ToyDomain.fs" />
    <Compile Include="..\Fuaran.Program.Tests\ToyWire.fs" Link="ToyWire.fs" />
    <Compile Include="..\Fuaran.Program.Tests\ToyScenarios.fs" Link="ToyScenarios.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Program.Runtime\Fuaran.Program.Runtime.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" />
  </ItemGroup>
</Project>
