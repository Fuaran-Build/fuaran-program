<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ParityTests.fs" />
    <!-- Phase 1715 — the differential host for the proved bounded fold. It
         references the oracle project, which holds the F* extraction; that
         project is NOT in the solution, and deliberately so: nothing packs it
         and nothing but this suite consumes it. -->
    <!-- The non-UI toy witness (Phase 1896), shared with Fuaran.Program.Tests
         so the generic differential below and the genericity tests there run
         the SAME domain. -->
    <Compile Include="..\Fuaran.Program.Tests\ToyDomain.fs" Link="ToyDomain.fs" />
    <!-- fuaran#2011: the toy codec and the driver-semantics-toy family's shared
         runner, so the generic differential below folds the SPECIFICATION's toy
         scenarios as well as this host's own corpus. -->
    <Compile Include="..\Fuaran.Program.Tests\ToyWire.fs" Link="ToyWire.fs" />
    <Compile Include="..\Fuaran.Program.Tests\ToyScenarios.fs" Link="ToyScenarios.fs" />
    <Compile Include="ProofOracleTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.Program.Parity\Fuaran.Program.Parity.fsproj" />
    <ProjectReference Include="..\..\proofs\oracle\Fuaran.Program.Proofs.Oracle.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
