<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BoundedActionsTests.fs" />
    <Compile Include="BoundedDriverTests.fs" />
    <Compile Include="DemandedTests.fs" />
    <!-- Program.fs is the Expecto entry point and stays last. -->
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Program.Bounded\Fuaran.Program.Bounded.fsproj" />
  </ItemGroup>
  <!-- The fixtures author trees (Fuaran.UI), build TreeOps + decode wire JSON
       (Fuaran.UI.Ops), assert against the op-stream sink contract
       (OpStream.Abstractions), use BindingSources as the store
       (Renderer.Core), and read the lowered DomPatch / ClientEffect wire
       vocabulary (ServerDriven). -->
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fuaran.UI" />
    <PackageReference Include="Fuaran.UI.Ops" />
    <PackageReference Include="Fuaran.UI.OpStream.Abstractions" />
    <PackageReference Include="Fuaran.UI.OpStream.Replay" />
    <PackageReference Include="Fuaran.UI.Renderer.Core" />
    <PackageReference Include="Fuaran.UI.ServerDriven" />
  </ItemGroup>
</Project>
