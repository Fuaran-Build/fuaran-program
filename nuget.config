<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- `local` FIRST: NuGet prefers the earlier-declared source for the same id+version, so a
         fresh dev pack shadows a released package without a version bump. -->
    <add key="local" value="../../local-nuget-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
